{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/*.test.js",
    "dev": "nodemon server.js",
    "dev:local": "node --env-file=.env.test server.js",
    "provision:local": "node --env-file=.env.test scripts/provision-local-user.js",
    "start": "node server.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.16.3",
    "supertest": "^7.3.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
