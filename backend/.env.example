# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173, http://127.0.0.1:5173

# PostgreSQL: replace placeholders with your own Supabase connection strings.
# Use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
JWT_ACCESS_SECRET="YourAccessSecretKeyHere"
JWT_REFRESH_SECRET="YourRefreshSecretKeyHere"

DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE".